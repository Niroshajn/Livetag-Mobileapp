{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["react", "react-native", "jest"],
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts",
    "src/screens/LoginScreen.js"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ]
}